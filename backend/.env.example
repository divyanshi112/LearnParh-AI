# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (To be configured in Phase 2)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/learnpath_ai

# Security & Tokens (set JWT_SECRET to a long, random value)
# JWT_SECRET=
# JWT_EXPIRES_IN=7d

# Gemini AI
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-3.5-flash

# RAG embeddings (local inference is the default and does not use Gemini quota)
# RAG_EMBEDDING_PROVIDER=local
# LOCAL_EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
# TRANSFORMERS_CACHE_DIR=
